    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (global.gameStarted) {
    if (!global.gamePaused) {
        //Restarting game
        if (scr_buttonPressed(global.restartButton))
            scr_restartGame();
            
        //Resetting game
        if (scr_buttonPressed(vk_f2))
            game_restart();
            
        //Incrementing game time
        timeMicro += delta_time;
        global.time += timeMicro div 1000000;
        timeMicro %= 1000000;
    }

    //Pausing game
    if (pauseDelay &lt; global.totalPauseDelay) {
        pauseDelay++;
    } else if (scr_buttonPressed(global.pauseButton)) {
        if (global.gamePaused) {
            instance_activate_all();
            
            if (surface_exists(pauseSurf))
                surface_free(pauseSurf);
                
            scr_saveConfig();
            io_clear();
        }
        
        global.gamePaused = !global.gamePaused;
        pauseDelay = 0;
    }
}

scr_setCaption();
</string>
          </argument>
        </arguments>
      </action>
    </event>
