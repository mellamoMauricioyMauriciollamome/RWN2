        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (global.gamePaused) {
    if (!surface_exists(pauseSurf)) {
        instance_activate_all();
        pauseSurf = surface_create(display_get_gui_width(), display_get_gui_height());
        surface_copy(pauseSurf, 0, 0, application_surface);
        instance_deactivate_all(true);
    }

    draw_surface(pauseSurf, 0, 0);
    draw_set_alpha(0.4);
    draw_set_colour(c_black);
    draw_rectangle(-1, -1, display_get_gui_width(), display_get_gui_height(), 0);
    
    draw_set_alpha(1);
    draw_set_colour(c_white);
    draw_set_halign(fa_center);
    draw_set_valign(fa_top);
    draw_set_font(fnt_pause1);
    draw_text(display_get_gui_width() / 2, display_get_gui_height() / 2 - 24, "PAUSE");
    
    draw_set_halign(fa_left);
    draw_set_valign(fa_top);
    draw_set_font(fnt_pause2);
    //draw_text(20,516,"Volume: " + string(global.volumeLevel) + "%");
    draw_text(20, 541, "Deaths: " + string(global.deaths));
    draw_text(20, 566, "Time: " + scr_formattedTime(global.time));
}
</string>
          </argument>
        </arguments>
      </action>
